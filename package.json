{
  "name": "genesis",
  "version": "0.1.0",
  "description": "Browser co-op puzzle platformer (Phaser + authoritative Node WebSocket server)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc",
    "test": "tsx scripts/sim-test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "private": true,
  "type": "module"
}
